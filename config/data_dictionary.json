{
  "version": "0.3.0-draft",
  "updated_at": "2026-11-26",
  "description": "内部统一健康数据字典。编码为项目自定义初始编码，不是国际标准术语；后续再研究到 LOINC/SNOMED CT 的映射。",
  "conversion": "standard_value = value * factor + offset",
  "data_types": ["number", "text", "date"],
  "metrics": {
    "BP.SYS": {
      "code": "BP.SYS",
      "name": "收缩压",
      "name_en": "Systolic blood pressure",
      "category": "vital_sign",
      "data_type": "number",
      "standard_unit": "mmHg",
      "allowed_units": {
        "mmHg": { "factor": 1.0, "offset": 0.0 },
        "kPa": { "factor": 7.50062, "offset": 0.0 }
      },
      "precision": 0,
      "plausible_range": { "min": 40, "max": 300 },
      "measurement_methods": ["诊室测量", "家庭自测", "动态监测"],
      "definition": "心脏收缩时动脉内的最高压力。",
      "template": { "template_id": "vital_signs.v1", "field_key": "systolic" }
    },
    "BP.DIA": {
      "code": "BP.DIA",
      "name": "舒张压",
      "name_en": "Diastolic blood pressure",
      "category": "vital_sign",
