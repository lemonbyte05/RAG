      "category": "body_measurement",
      "data_type": "number",
      "standard_unit": "kg",
      "allowed_units": {
        "kg": { "factor": 1.0, "offset": 0.0 },
        "公斤": { "factor": 1.0, "offset": 0.0 },
        "千克": { "factor": 1.0, "offset": 0.0 },
        "g": { "factor": 0.001, "offset": 0.0 },
        "斤": { "factor": 0.5, "offset": 0.0 }
